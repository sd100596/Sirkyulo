<Window x:Class="Sirkyulo.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sirkyulo"
        Width="330" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        UseLayoutRounding="True">

  <Window.Resources>
    <ResourceDictionary Source="Theme/Geist.xaml" />
  </Window.Resources>

  <!-- Appears next to the cursor rather than in the notification area, because that is where
       the user is looking immediately after a drop. -->
  <Border x:Name="Card"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource BorderDefault}"
          BorderThickness="1"
          CornerRadius="{StaticResource CornerCard}"
          Padding="16,13"
          Effect="{StaticResource MenuShadow}">
    <StackPanel>
      <TextBlock x:Name="TitleText"
                 FontFamily="{StaticResource GeistSans}"
                 FontSize="13" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimary}"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="BodyText"
                 FontFamily="{StaticResource GeistSans}"
                 FontSize="12"
                 Foreground="{StaticResource TextMuted}"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0" />
    </StackPanel>
  </Border>
</Window>
