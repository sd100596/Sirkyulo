<Window x:Class="Sirkyulo.App.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New group"
        Width="360" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <ResourceDictionary Source="Theme/Geist.xaml" />
  </Window.Resources>

  <!-- Explorer cannot be driven into inline-rename from outside, so naming happens here
       instead of on the desktop icon. -->
  <Border Background="{StaticResource Surface}"
          BorderBrush="{StaticResource BorderDefault}"
          BorderThickness="1"
          CornerRadius="{StaticResource CornerCard}"
          Padding="20"
          Effect="{StaticResource MenuShadow}"
          MouseLeftButtonDown="OnDragArea">
    <StackPanel>
      <TextBlock Text="Name this group"
                 FontFamily="{StaticResource GeistSans}"
                 FontSize="14" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimary}" />

      <TextBlock Text="A new icon appears on your desktop. Drag shortcuts onto it to fill it."
                 FontFamily="{StaticResource GeistSans}"
                 FontSize="12" Foreground="{StaticResource TextMuted}"
                 TextWrapping="Wrap" Margin="0,6,0,16" />

      <Border Background="{StaticResource SurfaceElevated}"
              BorderBrush="{StaticResource BorderDefault}"
              BorderThickness="1"
              CornerRadius="{StaticResource CornerSmall}"
              Height="40" Padding="12,0">
        <TextBox x:Name="NameBox"
                 VerticalAlignment="Center"
                 Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource TextPrimary}"
                 CaretBrush="{StaticResource TextPrimary}"
                 SelectionBrush="{StaticResource Accent}"
                 FontFamily="{StaticResource GeistSans}" FontSize="13"
                 MaxLength="64"
                 KeyDown="OnKeyDown" />
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0"
                Style="{StaticResource GhostButton}" />
        <Button x:Name="CreateButton" Content="Create" Click="OnCreate" IsDefault="True"
                Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
